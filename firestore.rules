rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'superAdmin';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || isSuperAdmin());
    }

    function isStrictAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function canManageStudent(studentId) {
      return isSuperAdmin()
        || (isStrictAdmin()
          && get(/databases/$(database)/documents/users/$(studentId)).data.ownerAdminId == request.auth.uid);
    }

    // A student may increment a course counter only as part of the same atomic
    // batch that creates their profile. This keeps registration atomic without
    // granting students general write access to course documents.
    function isInitialStudentEnrollment(courseId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let newUser = getAfter(userPath).data;
      return isAuthenticated()
        && !exists(userPath)
        && newUser.role == 'student'
        && newUser.ownerAdminId == resource.data.ownerAdminId
        && newUser.enrolledCourseIds is list
        && courseId in newUser.enrolledCourseIds
        && resource.data.studentCount is int
        && request.resource.data.studentCount == resource.data.studentCount + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount']);
    }

    function canReadNotification() {
      return isAuthenticated()
        && (
          resource.data.targetId == request.auth.uid
          || resource.data.targetId == getUserData().ownerAdminId
          || (
            getUserData().enrolledCourseIds is list
            && resource.data.targetId in getUserData().enrolledCourseIds
          )
        );
    }

    function canManageNotificationTarget(notificationData) {
      return isSuperAdmin()
        || (
          isStrictAdmin()
          && (
            (
              notificationData.targetType == 'teacher'
              && notificationData.targetId == request.auth.uid
            )
            || (
              notificationData.targetType == 'course'
              && (
                get(
                  /databases/$(database)/documents/courses/$(notificationData.targetId)
                ).data.ownerAdminId == request.auth.uid
                || get(
                  /databases/$(database)/documents/courses/$(notificationData.targetId)
                ).data.ownerAdminId == null
              )
            )
            || (
              notificationData.targetType == 'student'
              && canManageStudent(notificationData.targetId)
            )
          )
        );
    }

    // 1. Users collection & Tenant Assignment
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Allow user creation on initial registration:
      // - Students must have an ownerAdminId
      // - Users cannot self-assign superAdmin
      allow create: if isAuthenticated() && request.auth.uid == userId 
        && request.resource.data.role != 'superAdmin'
        && (request.resource.data.role != 'student' || (request.resource.data.ownerAdminId is string && request.resource.data.ownerAdminId.size() > 0));

      // Updates:
      // - Super Admin can transfer students (update ownerAdminId) and manage users
      // - Users can update their profile but CANNOT modify their role or ownerAdminId
      // - Admins can update their assigned students but CANNOT change student's role or ownerAdminId
      allow update: if isSuperAdmin()
        || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'ownerAdminId']))
        || (isStrictAdmin() && resource.data.ownerAdminId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'ownerAdminId']));

      allow delete: if isSuperAdmin();

      match /summaries/{summaryType} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Admin Join Codes
    match /admin_join_codes/{codeHash} {
      // Registration validates one exact document by its SHA-256 id before the
      // student has an account. Listing remains protected to prevent enumeration.
      allow get: if true;
      // Enumeration / list: strictly restricted to Admins and Super Admin (students cannot list codes)
      allow list: if isAdmin();
      // Admin can manage their own join code; Super Admin can manage all join codes
      allow create, update: if isSuperAdmin() || (isStrictAdmin() && request.resource.data.adminId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // 3. Courses, Units & Lessons
    match /courses/{courseId} {
      // Course documents contain catalogue metadata needed by the signup form.
      // Lesson content remains protected below.
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isInitialStudentEnrollment(courseId);

      match /units/{unitId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 4. Quizzes & Full Exams
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 5. Exam Attempts
    match /exam_attempts/{attemptId} {
      // Students can read their own attempts; teachers can read attempts
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      // Students can only create attempts for themselves; cannot tamper after write
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin()
        && canManageStudent(resource.data.studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'score',
          'percentage',
          'isPassed',
          'manuallyEditedAt',
          'manuallyEditedBy'
        ])
        && request.resource.data.manuallyEditedBy == request.auth.uid;
      allow delete: if isAdmin() && canManageStudent(resource.data.studentId);
    }

    // 6. Question Bank
    match /question_bank/{questionId} {
      allow read, write: if isAdmin();
    }

    // 7. Attendance Records
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 8. Evaluations (Bonus / Minus)
    match /evaluations/{evaluationId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 9. Notifications Queue
    match /notifications_queue/{notificationId} {
      allow read: if isAdmin() || canReadNotification();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && canManageNotificationTarget(request.resource.data);
      allow update: if (isSuperAdmin()
          || (isStrictAdmin() && resource.data.createdBy == request.auth.uid))
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'body',
          'targetType',
          'targetId',
          'updatedAt'
        ])
        && canManageNotificationTarget(request.resource.data);
      allow delete: if isSuperAdmin()
        || (isStrictAdmin() && resource.data.createdBy == request.auth.uid);
    }
  }
}
